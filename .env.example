# Copy to .env — never commit the real file.
POSTGRES_USER=dealer
POSTGRES_PASSWORD=dealer_dev_password
POSTGRES_DB=dealer
DATABASE_URL=postgresql://dealer:dealer_dev_password@db:5432/dealer?schema=public

API_PORT=4000
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
# How the *browser* reaches the API (baked into the web build).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public origin of the website (sitemap, robots.txt, structured data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# How the Next.js *server* reaches the API from inside Docker (service name, not localhost).
API_INTERNAL_URL=http://api:4000

# Signs 15-minute access tokens. Replace with a long random string: openssl rand -hex 32
# (Refresh tokens are opaque random values stored hashed in the DB; they need no secret.)
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me

# Where uploaded vehicle images are stored (a Docker volume in compose). Default: ./uploads
# UPLOADS_DIR=

# Auth cookies are `Secure` (HTTPS only) in production. The local Docker demo uses plain HTTP, so
# it is off here. MUST be true (or unset) on any real deployment behind HTTPS.
COOKIE_SECURE=false

# Rate limits per IP per minute. The defaults (5) are right for production. The browser tests
# (`pnpm test:e2e`) log in and submit leads many times a minute, so raise them for local runs:
# AUTH_RATE_LIMIT=100
# LEAD_RATE_LIMIT=100

# How long (seconds) the public pages reuse API responses. A car you unpublish or delete stays
# visible on the public site for up to this long. The browser tests set it to 0.
# CATALOG_REVALIDATE_SECONDS=30
# FACETS_REVALIDATE_SECONDS=300

# Logging: JSON lines on stdout (pino). Pipe through `pino-pretty` locally if you want colours.
# LOG_LEVEL=info

# /metrics (Prometheus). Set a token in production; the scraper sends `Authorization: Bearer <token>`.
# METRICS_TOKEN=

# Optional: error reporting. Empty = Sentry is off and nothing leaves the server.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
