generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  VIEWER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  assignedLeads Lead[]         @relation("AssignedLeads")
  notes         LeadNote[]     @relation("AuthoredNotes")
}

// Refresh tokens are stored hashed (sha256) so a DB leak does not leak live sessions.
// One row per session; rotation revokes the old row and creates a new one.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  PLUGIN_HYBRID
  LPG
}

enum Gearbox {
  MANUAL
  AUTOMATIC
}

enum VehicleStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
}

model Vehicle {
  id           String                   @id @default(uuid())
  vin          String                   @unique
  make         String
  model        String
  variant      String?
  year         Int
  mileage      Int
  // Integer cents. Never floats for money.
  priceCents   Int
  fuel         FuelType
  gearbox      Gearbox
  color        String
  description  String                   @default("")
  status       VehicleStatus            @default(DRAFT)
  images       VehicleImage[]
  // Generated column (see migration): weighted tsvector over make/model/variant/color/description.
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  leads        Lead[]

  @@index([searchVector], type: Gin)
  @@index([status, priceCents])
  @@index([status, year])
  @@index([status, make, model])
  @@index([status, mileage])
  @@index([status, createdAt])
}

model VehicleImage {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // Storage key (file name); `url` is what clients load.
  key       String  @unique
  url       String
  position  Int

  @@index([vehicleId, position])
}

enum LeadStatus {
  NEW
  CONTACTED
  TEST_DRIVE
  OFFER
  WON
  LOST
}

enum LeadSource {
  WEB
  PHONE
  MARKETPLACE
  OTHER
}

// A customer enquiry. Personal data: keep it minimal (see docs/decisions/0004).
model Lead {
  id               String     @id @default(uuid())
  // Nullable + SetNull: deleting a vehicle must not destroy the sales history of its leads.
  vehicleId        String?
  vehicle          Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  message          String
  status           LeadStatus @default(NEW)
  source           LeadSource @default(WEB)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  // When the visitor ticked the privacy consent box (set on public submissions).
  consentAt        DateTime?
  // First time the lead left NEW; basis for response-time statistics.
  firstRespondedAt DateTime?
  assignedToId     String?
  assignedTo       User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes            LeadNote[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([vehicleId])
  @@index([createdAt])
  @@index([firstRespondedAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Restrict)
  text      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Append-only record of who changed what. No foreign keys on purpose: the trail must outlive
// the entities it describes (deleted vehicles, removed users).
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  // Before/after values, e.g. { "status": { "from": "NEW", "to": "CONTACTED" } }
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
